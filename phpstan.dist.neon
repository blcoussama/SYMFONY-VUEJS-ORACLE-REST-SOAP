includes:
    - phpstan-platform.php

parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
        - migrations/
    excludePaths:
        analyseAndScan:
            - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    treatPhpDocTypesAsCertain: false
