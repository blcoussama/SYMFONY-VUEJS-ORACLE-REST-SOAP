{
    "name": "blcoussama/symfony-vuejs-oracle-rest-soap",
    "description": "NetOps : gestion des incidents et interventions réseau d'un opérateur télécom (Symfony 7.4, Vue.js 3, jQuery, Oracle/PostgreSQL, API REST et SOAP). Projet personnel de démonstration.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/blcoussama/SYMFONY-VUEJS-ORACLE-REST-SOAP",
    "authors": [
        {
            "name": "BELCADI Oussama"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.29",
        "twig/string-extra": "^3.24"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint": [
            "@php bin/console lint:twig templates",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:container",
            "@php bin/console doctrine:schema:validate --skip-sync"
        ],
        "qa": [
            "@lint",
            "@phpstan",
            "@cs",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": "false"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^12.5.40",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/dom-crawler": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "suggest": {
        "ext-soap": "Requis pour le service SOAP /soap/incidents (le WSDL reste servi sans).",
        "ext-oci8": "Connexion à Oracle (DATABASE_URL oci8://).",
        "ext-pdo_pgsql": "Connexion à PostgreSQL."
    }
}
