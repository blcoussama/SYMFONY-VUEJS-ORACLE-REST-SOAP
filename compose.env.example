# Modèle des variables de compose.yaml pour SYMFONY-VUEJS-ORACLE-REST-SOAP (NetOps).
# À copier en compose.env.example à la racine du dépôt ; pour un lancement local :
#   cp compose.env.example compose.env      (compose.env n'est jamais versionné)
#   docker compose --env-file compose.env up -d --build
# Sans fichier, compose.yaml utilise des valeurs par défaut FACTICES (poste de dev uniquement).
# Les variables sont préfixées NETOPS_ pour ne pas se mélanger aux variables de Symfony.
# Mots de passe : lettres, chiffres et « _ » uniquement (ils sont insérés dans DATABASE_URL).

# --- Oracle XE 21 (conteneur « oracle ») ---------------------------------------
# Mot de passe SYS/SYSTEM (obligatoire hors démo)
NETOPS_ORACLE_SYS_PASSWORD=
# Schéma applicatif créé au premier démarrage dans la PDB XEPDB1
NETOPS_ORACLE_USER=netops
NETOPS_ORACLE_PASSWORD=
# Schéma réservé à PHPUnit (docker compose --profile test run --rm test)
NETOPS_ORACLE_TEST_USER=netops_test
NETOPS_ORACLE_TEST_PASSWORD=
# Service Oracle (PDB) visé par DATABASE_URL
# NETOPS_ORACLE_SERVICE=XEPDB1

# --- Application Symfony (conteneur « app ») ------------------------------------
# Secret Symfony (obligatoire hors démo) : php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
NETOPS_APP_SECRET=
# 1 = applique les migrations Doctrine au démarrage, 0 = non
# NETOPS_RUN_MIGRATIONS=1
# Attente maximale de la base au démarrage, en secondes
# NETOPS_DB_WAIT_TIMEOUT=180

# --- Ports publiés sur 127.0.0.1 -------------------------------------------------
# Interface web, API REST et SOAP (nginx)
# NETOPS_HTTP_PORT=8088
# Oracle (SQL Developer, sqlplus) ; 1521 est souvent déjà pris par une autre base
# NETOPS_ORACLE_PORT=15210
