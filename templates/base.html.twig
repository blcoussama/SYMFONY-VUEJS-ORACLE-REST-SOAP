<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Incidents réseau{% endblock %} · {{ app_name }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%230b2545%22/><path d=%22M8 22 L13 12 L18 18 L24 9%22 stroke=%22%2313a89e%22 stroke-width=%223%22 fill=%22none%22/></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="skip-link btn btn-light" href="#contenu">Aller au contenu</a>
        {% if app.user %}
            {{ include('_partials/navbar.html.twig') }}
        {% endif %}

        <main id="contenu" class="{% block main_class %}container-xl py-4{% endblock %}" tabindex="-1">
            {{ include('_partials/flashes.html.twig') }}
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer border-top bg-white py-3 mt-auto">
            <div class="container-xl d-flex flex-wrap justify-content-between gap-2 text-body-secondary">
                <span>{{ app_name }} — projet personnel de démonstration, données entièrement fictives.</span>
                <span>
                    API REST <code>/api/v1</code> · SOAP <a href="{{ path('soap_incidents', {wsdl: ''}) }}">WSDL</a> ·
                    <a href="https://github.com/blcoussama/SYMFONY-VUEJS-ORACLE-REST-SOAP" rel="noopener">Code source</a>
                </span>
            </div>
        </footer>
    </body>
</html>
