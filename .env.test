# Contenu prévu du fichier .env.test (versionné) de NetOps — environnement PHPUnit.
# À copier à la racine du dépôt sous le nom « .env.test ».
# Une variable DATABASE_URL passée par l'environnement (PostgreSQL, Oracle en CI) reste prioritaire.

KERNEL_CLASS='App\Kernel'
APP_SECRET='test-only-not-a-secret'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
SLA_HOURS_P1=4
SLA_HOURS_P2=8
SLA_HOURS_P3=24
SLA_HOURS_P4=72
