# Contenu prévu du fichier .env (versionné) de NetOps — valeurs par défaut NON secrètes.
# À copier à la racine du dépôt sous le nom « .env ».
#
# Ordre de chargement Symfony : .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local
# Les vraies variables d'environnement (Docker, CI) priment toujours sur ces fichiers.
# Les secrets réels vont dans .env.local (non versionné) ou dans l'environnement.

###> symfony/framework-bundle ###
APP_ENV=dev
# APP_SECRET : un secret de développement factice est fourni par config/services.yaml (when@dev / when@test).
# En production, APP_SECRET est OBLIGATOIRE et doit venir de l'environnement (ou de .env.local).
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL de base hors requête HTTP (commandes, client SOAP de démonstration).
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite par défaut (aucun serveur à installer) : var/data_dev.db
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# PostgreSQL :
# DATABASE_URL="postgresql://netops:change_me@127.0.0.1:5432/netops?serverVersion=17&charset=utf8"
# Oracle (ext-oci8, voir compose.yaml) :
# DATABASE_URL="oci8://netops:change_me@127.0.0.1:15210/XEPDB1?service=true&servicename=XEPDB1&charset=AL32UTF8"
###< doctrine/doctrine-bundle ###

###> netops ###
# Délais SLA de résolution (heures) par priorité.
SLA_HOURS_P1=4
SLA_HOURS_P2=8
SLA_HOURS_P3=24
SLA_HOURS_P4=72
# Cache du WSDL de ext-soap : 0 = aucun, 1 = disque, 2 = mémoire, 3 = les deux.
SOAP_WSDL_CACHE=0
###< netops ###
