{
  "name": "netops-e2e",
  "private": true,
  "description": "Tests navigateur de bout en bout de NetOps (Playwright) et captures d'écran du README",
  "scripts": {
    "stack": "bash ./run-stack.sh",
    "test": "playwright test -c playwright.config.js --grep-invert @captures",
    "screenshots": "playwright test -c playwright.config.js --grep @captures",
    "install-browser": "playwright install chromium",
    "stop": "bash ./stop-stack.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
